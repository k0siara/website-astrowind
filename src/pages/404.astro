---
import Layout from '~/layouts/Layout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Header from '~/components/widgets/Header.astro';

const metadata = {
  title: '404',
};

---

<Layout metadata={metadata}>
 
  <Header
      position="left"
      links={[]}
      actions={[]}
      hideToggleOnMobile
    />
 
  <Hero2
    tagline="Ups, wygląda na to, że się zgubiłeś... 404!"
    title="Ale poczekaj, mam dla Ciebie darmowy Ebook! 📚"
    subtitle="Pobierz <b>146 stron</b> solidnej wiedzy o tworzeniu aplikacji mobilnych, od <b>architektury</b> po <b>bezpieczeństwo</b>, <b>testowanie</b> oraz praktyki i narzędzia, które pomogą Ci tworzyć niezawodne aplikacje mobilne <br><br> Pobierając ten ebook, otrzymasz <b>DARMOWY</b> dostęp do całego archiwum Mobile Dev Newsletter, które wysyłam od ostatnich <b>2 lat</b>"
    actions={[
      { 
        variant: 'primary', 
        text: 'Pobierz darmowy Ebook', 
        href: 'https://archiwum.mobiledevnews.com', 
        icon: 'tabler:download',
        target: '_blank',
      },
    ]}
    image={{
      src: '~/assets/images/ebook_archiwum.png',
      alt: 'Darmowy Ebook Archiwum Mobile Dev Newsletter - Wszystko Co Musisz Wiedzieć O Tworzeniu Aplikacji Mobilnych',
      loading: "eager"
    }}
  />
 
 </Layout>