---
import Layout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import HeroWithNewsletter from '~/components/widgets/HeroWithNewsletter.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import { getPermalink } from '~/utils/permalinks';
import FAQs from '~/components/widgets/FAQs.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import HeroText from '~/components/widgets/HeroText.astro';

const metadata = {
  title: 'Mobile Dev Newsletter - Darmowe Porady, Wskazówki i Zasoby dla Programistów Android i iOS',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  
 <HeroWithNewsletter
  image={{
    src: '~/assets/images/hero.png',
    alt: 'Architektura i Bezpieczeństwo Aplikacji Mobilnych',
  }}
>
  <Fragment slot="title">
    Chcesz pisać lepsze <span class="text-primary highlight">aplikacje mobilne</span>?
  </Fragment>

  <Fragment slot="subtitle">
    Dołącz do <b>darmowego newslettera</b>dla Android & iOS developerów. Co tydzień otrzymasz konkretne wskazówki, jak projektować solidną architekturę, dbać o bezpieczeństwo, testować i rozwijać swoje aplikacje jak profesjonalista.
  </Fragment>
</HeroWithNewsletter>

<Features2
    title="Co znajdziesz w środku?"
    subtitle=""
    tagline=""
    items={[
      {
        title: 'Wszystko w Jednym Miejscu',
        description: "Wszystko, czego potrzebujesz jako mobile developer – zebrane w jednym miejscu. Zamiast tracić czas na szukanie wartościowych źródeł, otrzymujesz gotowe wskazówki i aktualności, które naprawdę mają znaczenie.",
        icon: 'tabler:layout',
      },
      {
        title: 'Najlepsze Praktyki i Eksperckie Porady',
        description:
          "Dostajesz sprawdzone praktyki, które wykorzystuję na co dzień tworząc aplikacje dla banków i fintechów. Wdrażaj je od razu u siebie, bez zgadywania i bez marnowania czasu.",
        icon: 'tabler:brain',
      },
      {
        title: 'Solidne Fundamenty Aplikacji',
        description:
          "Dowiesz się, jak budować aplikacje, które są czytelne, skalowalne i łatwe w utrzymaniu. Architektura, która robi różnicę i ratuje Twój zespół przed chaosem.",
        icon: 'tabler:box',
      },
      {
        title: 'Bezpieczeństwo Made Simple',
        description:
          "Bezpieczna aplikacja nie musi być trudna w utrzymaniu. Pokażę Ci proste techniki i podejścia, które pozwolą Ci zabezpieczyć aplikację bez frustracji i niepotrzebnych komplikacji.",
        icon: 'tabler:lock',
      },
      {
        title: 'Aktualności i Artykuły',
        description:
          "W każdy czwartek dostaniesz pakiet sprawdzonych artykułów, nowości i materiałów. Nic zbędnego – tylko konkret, który naprawdę coś zmienia.",
        icon: 'tabler:news',
      },
      {
        title: 'Przydatne Biblioteki i Narzędzia',
        description: "Najlepsze biblioteki, rozszerzenia i narzędzia, które realnie usprawnią Twoją pracę. Dodatkowo – praktyczne wskazówki, jak je wdrażać z głową.",
        icon: 'tabler:tools',
      }
    ]}
  >
  </Features2>

<Testimonials
    title="Co mówią inni?"
    testimonials={[
      {
        testimonial: `
Twoje spostrzeżenia dotyczące architektury aplikacji i dbałość o szczegóły są bezcenne. Praktyczne porady i rady, które dzielisz, nie tylko poprawiły mój projekt, ale także dały mi nową perspektywę na pisanie wysokiej jakości kodu.`,
        name: 'Kasia Kowalczyk',
        job: 'Android Developer',
        image: {
          src: '~/assets/images/kasia_kowalczyk.jpg',
          alt: 'Zdjęcie Kasi',
        },
      },
      {
        testimonial: `Uwielbiam sposób, w jaki dzielisz się swoimi poradami i trikami, szczególnie tymi, które doskonaliłeś przez lata. To rzeczy, których nie można łatwo znaleźć bez doświadczenia. Będą dla mnie fundamentem.`,
        name: 'Paweł',
        job: 'Programista Android w dmt Software House',
        image: {
          src: '~/assets/images/no-profile-picture.jpg',
          alt: 'Zdjęcie Pawła',
        },
      },
      {
        testimonial: `Ogromna dawka wiedzy, która całkowicie zmieniła moją perspektywę na rozwój Androida. Widać, że nie tylko uczysz, ale dzielisz się praktycznym doświadczeniem.`,
        name: 'Bartłomiej Blachura',
        job: 'Programista Android w dmt Software House',
        image: {
          src: '~/assets/images/bartlomiej_b.jpeg',
          alt: 'Zdjęcie Bartłomieja',
        },
      },
    ]}
  />

